# Secrets — never commit
.env
.env.*
!.env.example

# Paper PDFs (licenses vary; the repo ships a manifest, not the files)
papers/*.pdf

# Local model weights (downloaded at setup time)
models/

# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/

# LLM response cache (may contain API outputs; regenerated on demand)
.cache/
